{
  "name": "enactus-ims-backend",
  "version": "1.0.0",
  "description": "Enactus VIPS-TC Inventory & Sales Management System Backend",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:push": "node scripts/guard-disposable-db.cjs && prisma db push",
    "db:seed": "node scripts/guard-disposable-db.cjs && tsx prisma/seed.ts",
    "db:reset": "node scripts/guard-disposable-db.cjs && prisma migrate reset --force && tsx prisma/seed.ts",
    "postinstall": "node -e \"const fs=require('fs'),p='./node_modules/whatsapp-rust-bridge/package.json';if(fs.existsSync(p)){const j=JSON.parse(fs.readFileSync(p,'utf8'));j.main='./dist/index.js';j.exports={'.':{'import':'./dist/index.js','require':'./dist/index.js','default':'./dist/index.js','types':'./dist/index.d.ts'}};fs.writeFileSync(p,JSON.stringify(j,null,4));}\"",
    "test": "node scripts/run-regression.cjs",
    "test:offline": "node --test tests/offline.test.cjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^20.17.19",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "prisma": "^5.22.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
