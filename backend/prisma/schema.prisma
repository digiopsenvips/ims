datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  DEVELOPER
  ADMIN
  HEAD
  MEMBER
}

enum EventStatus {
  UPCOMING
  ACTIVE
  ENDED
}

enum PaymentMethod {
  CASH
  UPI
  CASH_UPI
}

enum TransactionType {
  SALE
  GAME
}

enum GameStatus {
  ACTIVE
  INACTIVE
}

enum GameResult {
  WIN
  LOSE
}

enum GameSessionStatus {
  COMPLETED
  CANCELLED
}

model User {
  id           String           @id @default(uuid())
  name         String
  username     String           @unique
  email        String?          @unique
  passwordHash String           @map("password_hash")
  role         Role             @default(MEMBER)
  department   String?
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  permissions  HeadPermission[]
  sales        Sale[]
  gameSessions GameSession[]

  @@map("users")
}

model HeadPermission {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  permissionKey String   @map("permission_key")
  allowed       Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionKey])
  @@index([userId])
  @@map("head_permissions")
}

model Project {
  id        String    @id @default(uuid())
  name      String    @unique
  code      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  products  Product[]
  games     Game[]

  @@map("projects")
}

model Product {
  id              String            @id // Auto-generated ID: e.g. TAH-001, UPC-001
  name            String
  projectId       String            @map("project_id")
  basePrice       Decimal?          @map("base_price") @db.Decimal(10, 2)
  isDeleted       Boolean           @default(false) @map("is_deleted")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  inventory       Inventory?
  allocations     EventAllocation[]
  sales           Sale[]
  saleItems       SaleItem[]
  winRewardGames  Game[]            @relation("GameWinReward")
  loseRewardGames Game[]            @relation("GameLoseReward")
  rewardSessions  GameSession[]

  @@index([projectId])
  @@map("products")
}

model Inventory {
  id             String   @id @default(uuid())
  productId      String   @unique @map("product_id")
  quantityOnHand Int      @default(0) @map("quantity_on_hand")
  notes          String?
  lastUpdated    DateTime @default(now()) @updatedAt @map("last_updated")
  product        Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@map("inventory")
}

model Event {
  id            String            @id @default(uuid())
  name          String
  location      String
  startDatetime DateTime          @map("start_datetime")
  endDatetime   DateTime          @map("end_datetime")
  status        EventStatus       @default(UPCOMING)
  reconciledAt  DateTime?         @map("reconciled_at")
  isDeleted     Boolean           @default(false) @map("is_deleted")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  allocations   EventAllocation[]
  sales         Sale[]
  games         Game[]
  gameSessions  GameSession[]

  @@index([status])
  @@map("events")
}

model EventAllocation {
  id           String   @id @default(uuid())
  eventId      String   @map("event_id")
  productId    String   @map("product_id")
  allocatedQty Int      @default(0) @map("allocated_qty")
  priceAtEvent Decimal  @map("price_at_event") @db.Decimal(10, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([eventId, productId])
  @@index([eventId])
  @@index([productId])
  @@map("event_allocations")
}

model Game {
  id                  String        @id @default(uuid())
  name                String
  description         String?
  projectId           String?       @map("project_id")
  eventId             String?       @map("event_id")
  entryFee            Decimal       @map("entry_fee") @db.Decimal(10, 2)
  status              GameStatus    @default(ACTIVE)
  winRewardProductId  String        @map("win_reward_product_id")
  winRewardQuantity   Int           @default(1) @map("win_reward_quantity")
  loseRewardProductId String?       @map("lose_reward_product_id")
  loseRewardQuantity  Int           @default(1) @map("lose_reward_quantity")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  project             Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  event               Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  winRewardProduct    Product       @relation("GameWinReward", fields: [winRewardProductId], references: [id], onDelete: Restrict)
  loseRewardProduct   Product?      @relation("GameLoseReward", fields: [loseRewardProductId], references: [id], onDelete: Restrict)
  sessions            GameSession[]
  sales               Sale[]

  @@index([status])
  @@index([eventId])
  @@index([projectId])
  @@map("games")
}

model GameSession {
  id              String            @id @default(uuid())
  sessionCode     String            @unique @map("session_code") // e.g. GS-000001
  gameId          String            @map("game_id")
  eventId         String            @map("event_id")
  sellerId        String?           @map("seller_id")
  sellerName      String?           @map("seller_name")
  sellerUsername  String?           @map("seller_username")
  saleId          Int?              @unique @map("sale_id")
  receiptNumber   Int               @map("receipt_number")
  paymentMethod   PaymentMethod     @map("payment_method")
  entryFee        Decimal           @map("entry_fee") @db.Decimal(10, 2)
  cashAmount      Decimal?          @map("cash_amount") @db.Decimal(10, 2)
  upiAmount       Decimal?          @map("upi_amount") @db.Decimal(10, 2)
  result          GameResult
  rewardProductId String            @map("reward_product_id")
  rewardQuantity  Int               @default(1) @map("reward_quantity")
  customerName    String?           @map("customer_name")
  customerPhone   String?           @map("customer_phone")
  status          GameSessionStatus @default(COMPLETED)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  game            Game              @relation(fields: [gameId], references: [id], onDelete: Restrict)
  event           Event             @relation(fields: [eventId], references: [id], onDelete: Restrict)
  seller          User?             @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  rewardProduct   Product           @relation(fields: [rewardProductId], references: [id], onDelete: Restrict)
  sale            Sale?             @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([gameId])
  @@index([eventId])
  @@index([sellerId])
  @@index([receiptNumber])
  @@index([result])
  @@index([createdAt])
  @@map("game_sessions")
}

model Sale {
  id                   Int             @id @default(autoincrement()) // Internal DB ID
  receiptNumber        Int             @unique @map("receipt_number") // Canonical Sequential Receipt No. (#1, #2, #3...)
  transactionType      TransactionType @default(SALE) @map("transaction_type")
  gameId               String?         @map("game_id")
  clientTxId           String?         @unique @map("client_tx_id") // For offline sync idempotency
  eventId              String          @map("event_id")
  memberId             String?         @map("member_id")
  sellerUserIdAtSale   String?         @map("seller_user_id_at_sale")
  sellerUsernameAtSale String?         @map("seller_username_at_sale")
  sellerNameAtSale     String?         @map("seller_name_at_sale")
  totalAmount          Decimal         @map("total_amount") @db.Decimal(10, 2)
  paymentMethod        PaymentMethod   @map("payment_method")
  cashAmount           Decimal?        @map("cash_amount") @db.Decimal(10, 2)
  upiAmount            Decimal?        @map("upi_amount") @db.Decimal(10, 2)
  customerName         String?         @map("customer_name")
  customerPhone        String?         @map("customer_phone")
  saleTime             DateTime        @default(now()) @map("sale_time")
  createdAt            DateTime        @default(now()) @map("created_at")

  // Legacy fields for backward compatibility
  productId            String?         @map("product_id")
  quantity             Int?
  unitPrice            Decimal?        @map("unit_price") @db.Decimal(10, 2)

  event                Event           @relation(fields: [eventId], references: [id], onDelete: Restrict)
  member               User?           @relation(fields: [memberId], references: [id], onDelete: SetNull)
  product              Product?        @relation(fields: [productId], references: [id], onDelete: Restrict)
  game                 Game?           @relation(fields: [gameId], references: [id], onDelete: SetNull)
  gameSession          GameSession?
  items                SaleItem[]

  @@index([eventId])
  @@index([saleTime])
  @@index([memberId])
  @@index([receiptNumber])
  @@index([productId])
  @@index([transactionType])
  @@index([gameId])
  @@map("sales")
}

model SaleItem {
  id        Int      @id @default(autoincrement())
  saleId    Int      @map("sale_id")
  productId String   @map("product_id")
  quantity  Int
  unitPrice Decimal  @map("unit_price") @db.Decimal(10, 2)
  lineTotal Decimal  @map("line_total") @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}
